#!/bin/sh
# Pre-commit hook — runs formatter, linter and tests for the Rust microservice
# before allowing a commit. Install once per clone:
#   git config core.hooksPath .githooks

set -e

echo "[pre-commit] cargo fmt --check"
cargo fmt --all -- --check

echo "[pre-commit] cargo clippy"
cargo clippy --all-targets --quiet -- -D warnings

echo "[pre-commit] cargo test"
cargo test --quiet

echo "[pre-commit] OK"
